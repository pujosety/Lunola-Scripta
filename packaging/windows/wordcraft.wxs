<?xml version="1.0" encoding="utf-8"?>
<!--
  Lunola Scripta MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build lunola-scripta.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome + license, progress, and a finish page.

  UpgradeCode and the component GUIDs below belong to Lunola Scripta alone. Never copy them from (or
  into) a sibling Craft app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Lunola Scripta"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="075497F9-E861-45D0-9C7F-A74F8C34E6BA"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Lunola Scripta word processor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Lunola Scripta is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="LunolaScriptaIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LunolaScriptaIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://getlunola.com/apps/lunola-scripta" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getlunola.com/apps/lunola-scripta" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/lunola" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch Lunola Scripta (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Lunola Scripta" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#LunolaScriptaExe]" />
    <CustomAction Id="LaunchLunolaScripta" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLunolaScripta"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Lunola Scripta" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Lunola Scripta" Level="1">
      <ComponentGroupRef Id="LunolaScriptaFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="LunolaScriptaFiles" Directory="INSTALLFOLDER">
      <Component Id="LunolaScriptaApp" Guid="855DCEC6-9285-444F-9382-9654B83B34F6">
        <File Id="LunolaScriptaExe" Source="$(var.BinDir)\wordcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Lunola Scripta"
              Description="Lunola Scripta word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="LunolaScriptaIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\wordcraft.exe" Value="[#LunolaScriptaExe]" Type="string" />
      </Component>

      <!-- File associations (#295). Each document type gets a Lunola Scripta ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so Lunola Scripta shows in
           Explorer's "Open with". The Word, RTF and ODT types are also Lunola Scripta's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default: the installer never takes over .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall. -->
      <Component Id="LunolaScriptaFileTypes" Guid="EFF89E6A-F9B8-49F9-B3AE-E243347484B4">
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="Lunola Scripta" Value="Software\LunolaScripta\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\LunolaScripta\Capabilities" Name="ApplicationName" Value="Lunola Scripta" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LunolaScripta\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and save Word files." Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LunolaScripta\Capabilities" Name="ApplicationIcon" Value="&quot;[#LunolaScriptaExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\wordcraft.exe" Name="FriendlyAppName" Value="Lunola Scripta" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\wordcraft.exe\shell\open\command" Value="&quot;[#LunolaScriptaExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="LunolaScripta.Document" Description="Word Document" Icon="LunolaScriptaExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LunolaScripta.Document\shell\open\command" Value="&quot;[#LunolaScriptaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docx\OpenWithProgids" Name="Lunola Scripta.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\wordcraft.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LunolaScripta\Capabilities\FileAssociations" Name=".docx" Value="Lunola Scripta.Document" Type="string" />

        <ProgId Id="LunolaScripta.DocumentMacroEnabled" Description="Word Macro-Enabled Document" Icon="LunolaScriptaExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LunolaScripta.DocumentMacroEnabled\shell\open\command" Value="&quot;[#LunolaScriptaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docm\OpenWithProgids" Name="Lunola Scripta.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\wordcraft.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LunolaScripta\Capabilities\FileAssociations" Name=".docm" Value="Lunola Scripta.DocumentMacroEnabled" Type="string" />

        <ProgId Id="LunolaScripta.Template" Description="Word Template" Icon="LunolaScriptaExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LunolaScripta.Template\shell\open\command" Value="&quot;[#LunolaScriptaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotx\OpenWithProgids" Name="Lunola Scripta.Template" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\wordcraft.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LunolaScripta\Capabilities\FileAssociations" Name=".dotx" Value="Lunola Scripta.Template" Type="string" />

        <ProgId Id="LunolaScripta.TemplateMacroEnabled" Description="Word Macro-Enabled Template" Icon="LunolaScriptaExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LunolaScripta.TemplateMacroEnabled\shell\open\command" Value="&quot;[#LunolaScriptaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotm\OpenWithProgids" Name="Lunola Scripta.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\wordcraft.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LunolaScripta\Capabilities\FileAssociations" Name=".dotm" Value="Lunola Scripta.TemplateMacroEnabled" Type="string" />

        <ProgId Id="LunolaScripta.LegacyDocument" Description="Legacy Word Document" Icon="LunolaScriptaExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LunolaScripta.LegacyDocument\shell\open\command" Value="&quot;[#LunolaScriptaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.doc\OpenWithProgids" Name="Lunola Scripta.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\wordcraft.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LunolaScripta\Capabilities\FileAssociations" Name=".doc" Value="Lunola Scripta.LegacyDocument" Type="string" />

        <ProgId Id="LunolaScripta.LegacyTemplate" Description="Legacy Word Template" Icon="LunolaScriptaExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LunolaScripta.LegacyTemplate\shell\open\command" Value="&quot;[#LunolaScriptaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dot\OpenWithProgids" Name="Lunola Scripta.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\wordcraft.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LunolaScripta\Capabilities\FileAssociations" Name=".dot" Value="Lunola Scripta.LegacyTemplate" Type="string" />

        <ProgId Id="LunolaScripta.RichText" Description="Rich Text Document" Icon="LunolaScriptaExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LunolaScripta.RichText\shell\open\command" Value="&quot;[#LunolaScriptaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.rtf\OpenWithProgids" Name="Lunola Scripta.RichText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\wordcraft.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LunolaScripta\Capabilities\FileAssociations" Name=".rtf" Value="Lunola Scripta.RichText" Type="string" />

        <ProgId Id="LunolaScripta.OpenDocumentText" Description="OpenDocument Text" Icon="LunolaScriptaExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LunolaScripta.OpenDocumentText\shell\open\command" Value="&quot;[#LunolaScriptaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.odt\OpenWithProgids" Name="Lunola Scripta.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\wordcraft.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\LunolaScripta\Capabilities\FileAssociations" Name=".odt" Value="Lunola Scripta.OpenDocumentText" Type="string" />

        <ProgId Id="LunolaScripta.Markdown" Description="Markdown Document" Icon="LunolaScriptaExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LunolaScripta.Markdown\shell\open\command" Value="&quot;[#LunolaScriptaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids" Name="Lunola Scripta.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\wordcraft.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="LunolaScripta.PlainText" Description="Text Document" Icon="LunolaScriptaExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\LunolaScripta.PlainText\shell\open\command" Value="&quot;[#LunolaScriptaExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.txt\OpenWithProgids" Name="Lunola Scripta.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\wordcraft.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="LunolaScriptaCli">
        <File Id="LunolaScriptaCliExe" Source="$(var.BinDir)\wordcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
